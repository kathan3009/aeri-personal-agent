# Server
PORT=8787
HOST=127.0.0.1
APP_ACCESS_TOKEN=choose-a-long-private-access-code
DATA_DIR=.data
# Set this to use Neon Postgres instead of local JSON persistence.
DATABASE_URL=
# Sponsor model gateway: set both after redeeming credits.
NEON_AI_GATEWAY_API_KEY=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_MODEL=gpt-5-mini
# Direct Gemini video, YouTube and audio understanding.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
# Retailer browser and product research.
KERNEL_API_KEY=
KERNEL_RETAILER_URL=
EXA_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Mobile (public API origin only; enter access code in app)
EXPO_PUBLIC_API_URL=http://localhost:8787
