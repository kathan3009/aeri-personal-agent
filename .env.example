# API server; secrets stay in ignored .env. Use HOST=0.0.0.0 for same-Wi-Fi Expo Go.
PORT=8787
HOST=127.0.0.1
DATA_DIR=.data
# People sign in with a one-time code emailed to them (AgentMail below). Required in production: at least 32
# random characters, kept stable (it hashes sign-in codes). Generate with: openssl rand -hex 32
AERI_SECRET=
# Your email. The first time it signs in it takes over the data and store sign-ins kept before accounts existed.
AERI_OWNER_EMAIL=
# The old single-person access code, only so the owner keeps their existing store sign-ins (Kernel profile names).
APP_ACCESS_TOKEN=
# Emails (comma separated) that may open /v1/sites diagnostics.
AERI_ADMIN_EMAILS=
# Shown on /privacy and /terms as the contact address.
AERI_SUPPORT_EMAIL=
# Optional fixed sign-in for App Store review (give these to Apple; never a real person's email).
AERI_REVIEW_EMAIL=
AERI_REVIEW_CODE=
# Optional error tracking (Sentry). No messages, files or emails are sent.
SENTRY_DSN=
# Relational Neon persistence is built; live migration/compute remain gated by no-card-charge requirement.
# For local Expo verification override DATABASE_URL= even if your ignored .env contains a real URL.
DATABASE_URL=
# Prepaid Neon Gateway: branch-scoped ai_gateway:invoke credential only. No manual/automatic credit top-up.
NEON_AI_GATEWAY_API_KEY=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_MODEL=gpt-5-4-mini
NEON_AI_GATEWAY_VISION_MODEL=gemini-3-6-flash
# Small inline video/photo/YouTube and audio passed live probes in the owner's local environment.
# Keep flags zero in a fresh environment until you verify its transport. Gateway Files API is unsupported.
NEON_AI_GATEWAY_VIDEO_VERIFIED=0
NEON_AI_GATEWAY_AUDIO_VERIFIED=0
NEON_AI_GATEWAY_INLINE_MAX_BYTES=3000000
# Persisted daily UTC request quotas. These are NOT monetary billing caps.
# Whole server, and per person (one shopping run reserves up to ~40 steps).
NEON_AI_GATEWAY_DAILY_REQUEST_LIMIT=500
AERI_USER_DAILY_AI_REQUESTS=200
# Private store browser runs (comparisons, page checks, store carts): whole server and per person.
AERI_DAILY_BROWSER_RUNS=200
AERI_USER_DAILY_BROWSER_RUNS=12
# Optional direct Gemini takes precedence if set and bills the separate Google account.
# Activate only with an approved Google budget and models available on that account.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
# Exa product discovery and Kernel price/stock/cart review/Managed Auth.
# Retailer connection/profile IDs are server-side private metadata; no passwords or cookies here.
KERNEL_API_KEY=
KERNEL_RETAILER_URL=
EXA_API_KEY=
# Hosted servers receive email by AgentMail webhook (message.received → /webhooks/agentmail) and set AGENTMAIL_POLLING=0.
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_POLLING=
# Mobile public API origin only (production builds require https://).
EXPO_PUBLIC_API_URL=http://localhost:8787
# Stores each person can keep signed in at once.
KERNEL_MAX_STORE_CONNECTIONS=10
# Warm browser pools: KERNEL_POOLS=0 turns them off. Signed-in pools are one per person per store (billed while
# idle), so they stay off unless KERNEL_SIGNED_IN_POOLS=1.
KERNEL_POOLS=
KERNEL_SIGNED_IN_POOLS=
# Optional: Instacart Developer Platform key. With it, Instacart lists open as an official shopping-list page.
INSTACART_API_KEY=
# Development keys use https://connect.dev.instacart.tools
INSTACART_API_BASE=https://connect.instacart.com
# AgentMail: sends sign-in codes and gives each person their own Aeri address (one tap in Settings) for order
# emails and store sign-in codes. Each person's address is one inbox on your AgentMail plan.
AGENTMAIL_API_KEY=
# Optional: an existing inbox to send sign-in codes from, or a username for the one Aeri creates (aeri-sign-in).
AGENTMAIL_SENDER_INBOX_ID=
AGENTMAIL_SENDER_USERNAME=
# The owner's existing inbox from before accounts (kept when they tap Get your Aeri email address).
AGENTMAIL_INBOX_ID=
