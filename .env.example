# Server
PORT=8787
HOST=127.0.0.1
APP_ACCESS_TOKEN=choose-a-long-private-access-code
DATA_DIR=.data
# Set this to use Neon Postgres instead of local JSON persistence.
DATABASE_URL=
# Neon AI Gateway credit is posted; configure both values after creating a scoped key.
NEON_AI_GATEWAY_API_KEY=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_MODEL=gpt-5-mini
# Gateway video/photo understanding through its native Gemini route. Unverified until `npm run probe:gateway-video`
# passes; then set VIDEO_VERIFIED=1. Use a Gemini model ID listed by your Gateway (hyphenated, e.g. from /v1/models).
NEON_AI_GATEWAY_VISION_MODEL=
NEON_AI_GATEWAY_VIDEO_VERIFIED=0
# Direct Gemini: primary video, photo, YouTube and voice understanding. Separate Google billing from Neon credit.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.5-transcribe
# Retailer browser (price/stock checks, cart preparation) and product discovery. KERNEL_RETAILER_URL is the store opened
# when a list has no chosen store.
KERNEL_API_KEY=
KERNEL_RETAILER_URL=
EXA_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Mobile (public API origin only; enter access code in app)
EXPO_PUBLIC_API_URL=http://localhost:8787
