    "android": {"package": "com.kathan3009.aeri", "permissions": ["CAMERA", "RECORD_AUDIO"]},
    "plugins": ["expo-router", "expo-camera", ["expo-image-picker", {"photosPermission": "Choose a kitchen video for your agent."}], ["expo-audio", {"microphonePermission": "Talk to your personal agent."}], "expo-secure-store"],
    "experiments": {"typedRoutes": true}
  }
